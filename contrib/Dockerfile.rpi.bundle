# Dockerfile for building SickChill 2026.10.8+ on Raspberry Pi
# Uses Python 3.13 (Debian 13 / Trixie)
#
# Usage (example):
#   docker build -f Dockerfile.rpi.bundle -t sickchill-rpi-build .
#   docker run --rm -v $(pwd)/dist:/output sickchill-rpi-build

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_TIMEOUT=600 \
    PIP_RETRIES=100 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

# Install build dependencies and Python 3.13 (default on Trixie)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    libffi-dev \
    libssl-dev \
    libxml2-dev \
    libxslt1-dev \
    zlib1g-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    python3-setuptools \
    python3-wheel \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Confirm we have Python 3.13
RUN python3 --version | grep -q '3.13' || (echo "Python 3.13 not found" && exit 1)

# Install Rust (required for some modern dependencies such as cachecontrol / cryptography builds)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install build tooling in an isolated venv (system Python is externally managed, PEP 668)
RUN python3 -m venv /opt/poetry \
    && /opt/poetry/bin/pip install --upgrade pip setuptools wheel poetry
ENV PATH="/opt/poetry/bin:${PATH}"

# Create build directory and copy source
WORKDIR /build
COPY . /build/

# Build the package with Poetry (produces sdist + wheel)
RUN poetry build

# Copy artifacts to /output at run time so a bind-mounted /output receives them
CMD ["sh", "-c", "mkdir -p /output && cp -a /build/dist/. /output/ && python3 --version && ls -la /output && echo 'Build complete. Wheels/sdists are in /output'"]
