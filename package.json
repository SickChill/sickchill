    "css-loader": "^7.1.1",
    "globals": "^17.5.0",
    "grunt": "^1.6.1",
    "grunt-bower-concat": "git+https://github.com/miigotu/grunt-bower-concat.git",
    "grunt-bower-task": "^0.6.2",
    "grunt-cli": "^1.4.3",
    "grunt-contrib-clean": "^2.0.1",
